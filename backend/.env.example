# Copy this file to .env for local development and fill in real values.
# In production (Render), set these in the dashboard instead — never
# commit real secrets to git.

# --- Required ---

# Local dev / Docker default: SQLite. In production, set this to your
# Neon connection string instead (Settings > Environment on Render).
DATABASE_URL=sqlite:///expense_tracker.db

# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Optional: Sprint 18 (AI Spending Insight) + AI Chat Assistant ---
# Without this, /insights and /chat automatically fall back to their
# rule-based generators — both features still work, just without the
# LLM upgrade.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Optional: Sprint 19 (OCR Receipt Scanner) ---
# Where uploaded receipt images are written. On Render's free tier this
# directory does NOT survive redeploys (no persistent disk on the free
# plan) — fine for demoing, not for production without upgrading or
# adding object storage.
RECEIPT_STORAGE_DIR=storage/receipts

# --- Optional: Sprint 21 (Notifications) ---
# Leave any of these blank to skip that channel — /notifications/test
# only sends through channels that are actually configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

DISCORD_WEBHOOK_URL=
